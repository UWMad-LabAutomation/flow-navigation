<?xml version="1.0"?>
<!--
  Minimal Gazebo Harmonic world for the I2RT LinearBot FLOW base.

  The MecanumDrive system is used as a first holonomic approximation of the
  powered-caster base. It accepts x, y, and yaw velocity commands on the
  /model/flow_base/cmd_vel Gazebo Transport topic.
-->
<sdf version="1.9">
  <world name="flow_base_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="flow_base" xmlns:gz="http://gazebosim.org/schema">
      <!-- Lift the wheel centers by the wheel radius so the wheels touch z=0. -->
      <pose>0 0 0.080 0 0 0</pose>

      <link name="base_link">
        <pose>0 0 0.100 0 0 0</pose>
        <inertial>
          <!-- 72 kg chassis plus four 2 kg wheels gives the documented 80 kg. -->
          <mass>72.0</mass>
          <inertia>
            <ixx>2.002584</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>3.624006</iyy>
            <iyz>0</iyz>
            <izz>5.146590</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.751 0.542 0.200</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.30 0.65 1</ambient>
            <diffuse>0.12 0.30 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.751 0.542 0.200</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- A planar lidar gives AMCL and both Nav2 costmaps obstacle data. -->
      <link name="laser_link">
        <pose>0 0 0.220 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.000001</ixx>
            <iyy>0.000001</iyy>
            <izz>0.000001</izz>
          </inertia>
        </inertial>
        <sensor name="laser" type="gpu_lidar">
          <topic>/model/flow_base/scan</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.12</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <alwaysOn>true</alwaysOn>
          <visualize>true</visualize>
        </sensor>
      </link>

      <joint name="base_link_to_laser_link" type="fixed">
        <parent>base_link</parent>
        <child>laser_link</child>
      </joint>

      <!--
        Each wheel uses anisotropic friction to approximate mecanum rollers.
        The -90 degree link rotation aligns the visual cylinder with the
        base Y axis, and each joint explicitly uses that same rolling axis.
      -->
      <link name="front_left_wheel">
        <pose>0.2955 0.2910 0 -1.5708 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.002048</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.002048</iyy>
            <iyz>0</iyz>
            <izz>0.002048</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.080</radius>
              <length>0.050</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.080</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="front_right_wheel">
        <pose>0.2955 -0.2910 0 -1.5708 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.002048</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.002048</iyy>
            <iyz>0</iyz>
            <izz>0.002048</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.080</radius>
              <length>0.050</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.080</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="rear_left_wheel">
        <pose>-0.2955 0.2910 0 -1.5708 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.002048</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.002048</iyy>
            <iyz>0</iyz>
            <izz>0.002048</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.080</radius>
              <length>0.050</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.080</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="rear_right_wheel">
        <pose>-0.2955 -0.2910 0 -1.5708 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.002048</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.002048</iyy>
            <iyz>0</iyz>
            <izz>0.002048</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.080</radius>
              <length>0.050</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.080</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <joint name="front_left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>front_left_wheel</child>
        <axis><xyz expressed_in="base_link">0 1 0</xyz></axis>
      </joint>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>front_right_wheel</child>
        <axis><xyz expressed_in="base_link">0 1 0</xyz></axis>
      </joint>
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>rear_left_wheel</child>
        <axis><xyz expressed_in="base_link">0 1 0</xyz></axis>
      </joint>
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>rear_right_wheel</child>
        <axis><xyz expressed_in="base_link">0 1 0</xyz></axis>
      </joint>

      <plugin filename="gz-sim-mecanum-drive-system"
              name="gz::sim::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>0.582</wheel_separation>
        <wheelbase>0.591</wheelbase>
        <wheel_radius>0.080</wheel_radius>
        <min_acceleration>-1.0</min_acceleration>
        <max_acceleration>1.0</max_acceleration>
        <odom_publish_frequency>20</odom_publish_frequency>
        <topic>/model/flow_base/cmd_vel</topic>
        <odom_topic>/model/flow_base/odometry</odom_topic>
        <tf_topic>/model/flow_base/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
